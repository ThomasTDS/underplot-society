# Copy to /etc/underplot/<environment>.env on the server (root-only, mode 600) and fill
# in. Never commit the real file. The environment is the name of the folder that holds
# deploy.sh on the server: /opt/underplot/staging or /opt/underplot/production.

# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Generate with: openssl rand -hex 24
DB_PASSWORD=

# Generate with: openssl rand -hex 32 (at least 32 characters). Shared by the site and
# the API: cache revalidation and page view counts. Empty: both are off.
REVALIDATE_SECRET=

# The site and the admin panel, each on its own host.
#   staging:    https://staging.underplotsociety.com.br, staging-admin.underplotsociety.com.br
#   production: https://underplotsociety.com.br,         admin.underplotsociety.com.br
SITE_URL=https://staging.underplotsociety.com.br
APP_URL=https://staging.underplotsociety.com.br
ADMIN_DOMAIN=staging-admin.underplotsociety.com.br

# "on" in production only: search engines may index the site. Anything else keeps it
# out of them (robots.txt, meta and X-Robots-Tag).
SITE_INDEXING=

# The Substack address (https). Empty: no newsletter link.
NEWSLETTER_URL=
