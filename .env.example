# Copy to .env and fill in the two required values before `docker compose up`.

# Required. Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Required. Any strong password; the database is created with it on first start.
DB_PASSWORD=

# Optional.
DB_DATABASE=underplot
DB_USERNAME=underplot

# Host ports, all bound to 127.0.0.1.
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
