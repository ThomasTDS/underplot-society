{
    "openapi": "3.1.2",
    "info": {
        "title": "Underplot Society",
        "version": "1.0.0",
        "description": "Read-only API behind the Underplot Society site. Every path is under `/api`; content paths take a language prefix (`en`, `pt-br` or `es`)."
    },
    "servers": [
        {
            "url": "https://staging.underplotsociety.com.br/api",
            "description": "Staging"
        }
    ],
    "paths": {
        "/v1/{locale}/articles": {
            "get": {
                "operationId": "v1.articles.index",
                "tags": [
                    "Article"
                ],
                "parameters": [
                    {
                        "name": "locale",
                        "in": "path",
                        "required": true,
                        "description": "The locale ID",
                        "schema": {
                            "$ref": "#/components/schemas/Locale"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10000
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50
                        }
                    },
                    {
                        "name": "area",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                            "maxLength": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ArticleSummaryResource"
                                            }
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer"
                                                },
                                                "last_page": {
                                                    "type": "integer"
                                                },
                                                "per_page": {
                                                    "type": "integer"
                                                },
                                                "total": {
                                                    "type": "integer"
                                                }
                                            },
                                            "required": [
                                                "current_page",
                                                "last_page",
                                                "per_page",
                                                "total"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/{locale}/articles/{slug}": {
            "get": {
                "operationId": "v1.articles.show",
                "tags": [
                    "Article"
                ],
                "parameters": [
                    {
                        "name": "locale",
                        "in": "path",
                        "required": true,
                        "description": "The locale ID",
                        "schema": {
                            "$ref": "#/components/schemas/Locale"
                        }
                    },
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`ArticleResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/ArticleResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "operationId": "health",
                "description": "Failure details go to the log only; the response never exposes\nhosts, paths, credentials or driver messages.",
                "summary": "Report whether the API can serve requests, including database access",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "error"
                                        },
                                        "error": {
                                            "type": "string",
                                            "const": "database_unavailable"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "error"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AreaResource": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "slug",
                    "name"
                ],
                "title": "AreaResource"
            },
            "ArticleResource": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "locale": {
                        "$ref": "#/components/schemas/Locale"
                    },
                    "title": {
                        "type": "string"
                    },
                    "summary": {
                        "type": "string"
                    },
                    "published_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "area": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/AreaResource"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "cover": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/CoverResource"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "body": {
                        "type": "string",
                        "description": "Markdown."
                    },
                    "seo": {
                        "type": "object",
                        "properties": {
                            "title": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "title",
                            "description"
                        ]
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "translations": {
                        "type": "object",
                        "description": "Slug of this article in each language it is published in, keyed by\nlanguage, for the language switcher and hreflang links.",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "slug",
                    "locale",
                    "title",
                    "summary",
                    "published_at",
                    "area",
                    "cover",
                    "body",
                    "seo",
                    "updated_at",
                    "translations"
                ],
                "title": "ArticleResource"
            },
            "ArticleSummaryResource": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "locale": {
                        "$ref": "#/components/schemas/Locale"
                    },
                    "title": {
                        "type": "string"
                    },
                    "summary": {
                        "type": "string"
                    },
                    "published_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "area": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/AreaResource"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "cover": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/CoverResource"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "required": [
                    "slug",
                    "locale",
                    "title",
                    "summary",
                    "published_at",
                    "area",
                    "cover"
                ],
                "title": "ArticleSummaryResource"
            },
            "CoverResource": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "alt": {
                        "type": "string"
                    },
                    "width": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "height": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    }
                },
                "required": [
                    "url",
                    "alt",
                    "width",
                    "height"
                ],
                "title": "CoverResource"
            },
            "Locale": {
                "type": "string",
                "description": "The languages the site publishes in. Every article is written in all three. Keep in sync with the frontend's frontend/src/i18n/config.ts.\n",
                "enum": [
                    "en",
                    "pt-br",
                    "es"
                ],
                "title": "Locale"
            }
        },
        "responses": {
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}